<!-- Adaptive icon foreground: the Waypair v2 artwork
     (assets/brand/waypair/waypair-icon-v2.png, 1024 px export). The inset
     keeps the glyph inside the adaptive mask's safe area; the full-bleed blue
     extends past every mask. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="5dp">
    <bitmap
        android:src="@drawable/ic_launcher_waypair_v2"
        android:gravity="fill"
        android:filter="true" />
</inset>
