+    #[test]
+    fn queued_file_display_preserves_live_controls_and_queue_retry_ownership() {
+        let (mut transfer, mut item) = queued_transfer();
+        assert_eq!(transfer_display_owner(&transfer, &item), TransferDisplayOwner::Live);
+        transfer.state = TransferState::Paused;
+        assert_eq!(transfer_display_owner(&transfer, &item), TransferDisplayOwner::Live);
+        item.status = QueueStatus::Failed { error: "offline".into() };
+        assert_eq!(transfer_display_owner(&transfer, &item), TransferDisplayOwner::Queue);
+        transfer.state = TransferState::Failed(nectarlink_core::TransferFailure::Unreachable);
+        assert_eq!(transfer_display_owner(&transfer, &item), TransferDisplayOwner::Queue);
+        item.status = QueueStatus::Waiting;
+        assert_eq!(transfer_display_owner(&transfer, &item), TransferDisplayOwner::Queue);
+        transfer.state = TransferState::Running;
+        assert_eq!(transfer_display_owner(&transfer, &item), TransferDisplayOwner::Queue);
+        item.status = QueueStatus::Sending;
+        assert_eq!(transfer_display_owner(&transfer, &item), TransferDisplayOwner::Live);
+        transfer.state = TransferState::Done { saved: Vec::new() };
+        assert_eq!(transfer_display_owner(&transfer, &item), TransferDisplayOwner::Queue);
+        item.status = QueueStatus::Expired { error: "expired".into() };
+        assert_eq!(transfer_display_owner(&transfer, &item), TransferDisplayOwner::Queue);
+    }
+
