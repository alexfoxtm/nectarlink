-/// Serializes the current `send_queue` into `(json, waiting_count, total_count, has_failed_or_expired)`.
+/// Which representation owns a matching outgoing file transfer's display.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum TransferDisplayOwner {
+    Independent,
+    Live,
+    Queue,
+}
+
+/// A queue retry or failure owns its row; only a sending queue item yields
+/// to the live Running/Paused row with its progress and pause/resume controls.
+/// This selects presentation only: neither underlying record is removed.
+pub(crate) fn transfer_display_owner(transfer: &Transfer, item: &QueueItem) -> TransferDisplayOwner {
+    if transfer.direction != Direction::Outgoing
+        || transfer.id != item.id
+        || transfer.device != item.peer
+        || !item.kind.is_file_based()
+    {
+        return TransferDisplayOwner::Independent;
+    }
+    if matches!(item.status, QueueStatus::Sending)
+        && matches!(transfer.state, TransferState::Running | TransferState::Paused)
+    {
+        TransferDisplayOwner::Live
+    } else {
+        TransferDisplayOwner::Queue
+    }
+}
